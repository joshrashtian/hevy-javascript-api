{
  "name": "hevy-react",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "description": "React bindings for the Hevy public API",
  "files": ["dist"],
  "keywords": ["hevy", "react", "workout", "fitness"],
  "license": "ISC",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate.mjs",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
